{
  "name": "markview",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:firefox": "playwright test --project=firefox",
    "build:portable": "tsc --noEmit && vite build --config vite.config.portable.ts && node scripts/make-usb-package.mjs",
    "test:e2e:portable": "playwright test -c playwright.portable.config.ts",
    "build:web": "tsc --noEmit && vite build && node scripts/make-web-package.mjs",
    "test:e2e:deploy": "playwright test e2e/deploy.spec.ts --project=chromium"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@dagrejs/dagre": "^3.1.3",
    "@lezer/highlight": "^1.2.5",
    "dompurify": "^3.4.17",
    "highlight.js": "^11.12.0",
    "idb": "^8.0.4",
    "katex": "^0.19.1",
    "lucide-react": "^1.61.0",
    "markdown-it": "^15.0.3",
    "mermaid": "^12.2.0",
    "morphdom": "^2.7.8",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/dagre": "^0.7.54",
    "@types/markdown-it": "^14.2.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.0.5"
  }
}
